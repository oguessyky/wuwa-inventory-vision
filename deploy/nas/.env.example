# Copied to .env by setup.sh the first time; yours after that. See docker-compose.yaml.

# Where the data lives: a folder on the NAS (made if missing), or leave it out for a
# Docker volume. NOT the folder that syncs from your PC -- a database must not be synced
# while it is being written.
# WUWA_DATA=/volume1/docker/wuwa-vision-data

# What Docker calls them, if you name things your own way.
# WUWA_IMAGE=wuwa-vision-home
# WUWA_CONTAINER=wuwa-vision

# Whose network the app shares, so that it is on the same 127.0.0.1 as Tailscale.
# setup.sh works this out and writes it here; set it yourself only to overrule it.
#   host                    Tailscale is on the NAS itself, or in a container on the host's network
#   container:<its name>    Tailscale is a container with a network of its own
# WUWA_NETWORK=host
