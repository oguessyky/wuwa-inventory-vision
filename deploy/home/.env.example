# Copy this file to .env, beside docker-compose.yaml, and fill in the first line (D183).

# A Tailscale auth key, from https://login.tailscale.com/admin/settings/keys -- used once, on the
# first start, to put this home on your tailnet. Afterwards you may delete it from here.
TS_AUTHKEY=tskey-auth-PUT-YOURS-HERE

# This home's name on your tailnet: it is opened at http://<this name>.<your tailnet>.ts.net:4000
# A second home beside the first -- to try a new version -- takes another, e.g. wuwa-home-test.
# TS_HOSTNAME=wuwa-home

# What Docker calls the two containers (the second ends in -tailscale). Another for a second home.
# WUWA_NAME=wuwa-home

# Where the data lives. Default: a data folder beside this file. NOT a folder that syncs from a
# PC -- a database must not be synced while it is being written.
# WUWA_DATA=./data

# Which version of the app. Default: the newest. Pin one (e.g. 1.0.4) to update only when you say.
# WUWA_VERSION=latest

# Which image. Default: the published one. To try a home on the image a NAS has already built from
# source (the build-from-source home of docs/nas.md), beside the one you have:
#   WUWA_IMAGE=wuwa-vision-home   WUWA_VERSION=latest   TS_HOSTNAME=wuwa-home-test   WUWA_NAME=wuwa-home-test
# WUWA_IMAGE=ghcr.io/oguessyky/wuwa-inventory-vision-home
