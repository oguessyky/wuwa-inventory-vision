# Only for a server started with `docker compose` from a folder (D183, D186): copy this file to .env
# beside docker-compose.yaml and fill in the first line. Pasted into a NAS's Docker app, the key
# goes in the compose file itself, over tskey-auth-PUT-YOURS-HERE, and this file is not needed.

# A Tailscale auth key, from https://login.tailscale.com/admin/settings/keys -- used once, on the
# first start, to put this server on your tailnet. Afterwards you may delete it from here.
TS_AUTHKEY=tskey-auth-PUT-YOURS-HERE

# This server's name on your tailnet: it is opened at http://<this name>.<your tailnet>.ts.net:4000
# A second server beside the first -- to try a new version -- takes another, e.g. wuwa-server-test.
# TS_HOSTNAME=wuwa-server

# Where the data lives. Default: a data folder beside this file. NOT a folder that syncs from a
# PC -- a database must not be synced while it is being written.
# WUWA_DATA=./data

# Which version of the app. Default: the newest. Pin one (e.g. 1.1.0) to update only when you say.
# WUWA_VERSION=latest

# Which image. Default: the published one. To try a server on the image a NAS has already built from
# source (the build-from-source server of docs/nas.md), beside the one you have:
#   WUWA_IMAGE=wuwa-vision-server   WUWA_VERSION=latest   TS_HOSTNAME=wuwa-server-test
# WUWA_IMAGE=ghcr.io/oguessyky/wuwa-inventory-vision-server
