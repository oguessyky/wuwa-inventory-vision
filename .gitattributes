# The built pages: generated files, taken as they are
src/wuwa_vision/web/ui/** -text

# Run on Linux (the NAS): a carriage return in one stops it starting
*.sh text eol=lf
deploy/nas/** text eol=lf

# Drawings are built into the pages by content: the same bytes on every machine
*.svg text eol=lf

# The ready-made home (D183) and its workflow: read on Linux
deploy/home/** text eol=lf
deploy/tailscale-image/** text eol=lf
.github/** text eol=lf

# The double-click files of a release (D184): run by cmd.exe, which wants CRLF
*.cmd text eol=crlf
